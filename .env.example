# Local server
PORT=3000

# Apple Wallet
APPLE_PASS_TYPE_IDENTIFIER=pass.example.member.card
APPLE_TEAM_IDENTIFIER=YOUR_APPLE_TEAM_ID
APPLE_ORGANIZATION_NAME=Your Organization Name
# Use local paths for development. Cloud Run mounts these files under /secrets/apple.
APPLE_SIGNER_CERT_PATH=passcert.pem
APPLE_SIGNER_KEY_PATH=passkey.pem
APPLE_WWDR_CERT_PATH=AppleWWDRCAG4.pem

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=1234567890123456789
# Local development may use a JSON key. Omit this variable on Cloud Run to use its service identity.
GOOGLE_APPLICATION_CREDENTIALS=google-key.json
PUBLIC_BASE_URL=https://cards.example.org

# Optional: enables the Google Wallet hasUsers install-tracking job.
# Set to the email of a dedicated service account used only to call
# /internal/check-installs via an OIDC-authenticated Cloud Scheduler job.
INSTALLS_SCHEDULER_SA_EMAIL=

# Creator access (local development only; Cloud Run mounts these from Secret Manager)
CREATOR_ACCESS_CODE=replace-with-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters